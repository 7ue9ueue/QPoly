# Per-round CI plan for .github/workflows/large-opt.yml (exploration 014; sourced by every job).
MICRO=1
MICRO_REPS=7
MICRO_PARSE=0
MICRO_OVL=0
MICRO_NTT=0
MICRO_ABLATE=1
PERF=0   # round 1: the runners expose no PMU (all hardware events <not supported>)
E2E=0
# run_e2e.sh (work/ntt/conv_large): STANDALONE "name:@io MAKE_ARGS;..." single files from
# work/ntt/io_large/make_submission.py; io = the exploration-011 deliverable (judge record 454 ms).
VARIANTS=""
REFS=" "
STANDALONE="io:@io --source final_io_main.cpp;tw:@io --source ../large_opt/main_opt.cpp --define QO_TW=1;twh:@io --source ../large_opt/main_opt.cpp --define QO_TW=1 --define QO_PARSE=1 --define QO_SUB=65536 --define QO_SKEW=1088"
THP_MODES="madvise"
REPS=7
OFFICIAL=0
OFFICIAL_BUILDS=""
