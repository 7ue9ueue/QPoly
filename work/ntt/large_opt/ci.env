# Per-round CI plan for .github/workflows/large-opt.yml (exploration 014; sourced by every job).
MICRO=1
MICRO_REPS=7
PERF=1
E2E=1
# run_e2e.sh (work/ntt/conv_large): STANDALONE "name:@io MAKE_ARGS;..." single files from
# work/ntt/io_large/make_submission.py; io = the exploration-011 deliverable (judge record 454 ms).
VARIANTS=""
REFS=" "
STANDALONE="io:@io --source final_io_main.cpp;s17:@io --source ../large_opt/main_opt.cpp --define QO_PARSE=1 --define QO_SKEW=1088;s17p:@io --source ../large_opt/main_opt.cpp --define QO_PARSE=1 --define QO_SKEW=1088 --define QO_PF=384;p0:@io --source ../large_opt/main_opt.cpp --define QO_PARSE=1 --define QO_SKEW=0 --define QO_PF=384"
THP_MODES="madvise"
REPS=7
OFFICIAL=0
OFFICIAL_BUILDS=""
