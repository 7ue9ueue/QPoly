# OFFICIAL_BUILDS "name:ARGS" uses conv_large/make_submission.py (ref010 = exploration-010 deliverable,
# byte-exact, the checker reference); "name:@io ARGS" uses io_large/make_submission.py.
# Per-round CI plan for .github/workflows/large-opt.yml (exploration 014; sourced by every job).
MICRO=0
MICRO_REPS=7
MICRO_PARSE=1
MICRO_FMT=0
MICRO_FMTABL=0
MICRO_OVL=0
MICRO_NTT=0
MICRO_ABLATE=0
PERF=0   # round 1: the runners expose no PMU (all hardware events <not supported>)
E2E=1
# run_e2e.sh (work/ntt/conv_large): STANDALONE "name:@io MAKE_ARGS;..." single files from
# work/ntt/io_large/make_submission.py; io = the exploration-011 deliverable (judge record 454 ms).
VARIANTS=""
REFS=" "
STANDALONE="io_p:@io --source final_io_main.cpp --probe;fin_p:@io --source ../large_opt/final_opt_main.cpp --probe;fin:@io --source ../large_opt/final_opt_main.cpp;s4q_p:@io --source ../large_opt/main_opt.cpp --define QO_FMT=9 --define QO_PARSE=2 --define QO_SUB=65536 --define QO_SKEW=1088 --probe"
THP_MODES="madvise"
REPS=7
OFFICIAL=1
OFFICIAL_BUILDS="ref010:;fin:@io --source ../large_opt/final_opt_main.cpp;fin_probe:@io --source ../large_opt/final_opt_main.cpp --probe"
