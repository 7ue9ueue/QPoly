# Per-round CI plan for .github/workflows/ntt-conv-large.yml (sourced by every job).
KERNEL=0
PASSES="check time"
CHECK_LG=23
ONLY="final,b0zs"
# I/O job (exploration 011): work/ntt/io_large/run_io.sh (unit tests over all values < 1e9, timing).
IO=1
# End-to-end: "@io ARGS" builds with work/ntt/io_large/make_submission.py (io_main.cpp).
E2E=1
VARIANTS=""
STANDALONE="final:;io007:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=0;guard:@io --define QI_INPUT=1 --define QI_PARSE=0 --define QI_FMT=0;fmt:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=1;tail:@io --define QI_INPUT=1 --define QI_PARSE=1 --define QI_FMT=0;both:@io;both_probe:@io --probe;final_probe:--probe"
REFS="403499"
THP_MODES="madvise"
REPS=7
# Official: first build must be byte-exact (its outputs verify later builds via the checker).
OFFICIAL=1
OFFICIAL_BUILDS="final:;both:@io"
