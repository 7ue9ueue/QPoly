# Per-round CI plan for .github/workflows/ntt-conv-large.yml (sourced by both jobs).
# Kernel job: KERNEL=1 runs run.sh with PASSES/ONLY/REPS/CHECK_LG.
KERNEL=0
PASSES="check time"
CHECK_LG=25
REPS=7
# End-to-end job: E2E=1 runs run_e2e.sh with VARIANTS/STANDALONE/REFS/CASES_LIST/THP_MODES.
E2E=1
VARIANTS="b0zs:-DQL_MODE=2;b0:-DQL_MODE=0"
STANDALONE="sub_b0zs:--mode 2"
REFS="403499 303498"
THP_MODES="madvise always"
