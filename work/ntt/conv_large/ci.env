# Per-round CI plan for .github/workflows/ntt-conv-large.yml (sourced by every job).
# Kernel job: KERNEL=1 runs run.sh with PASSES/ONLY/REPS/CHECK_LG.
KERNEL=0
PASSES="check time"
CHECK_LG=25
ONLY="b0zs,b0"
# End-to-end job: E2E=1 runs run_e2e.sh with VARIANTS/STANDALONE/REFS/CASES_LIST/THP_MODES/REPS.
E2E=1
VARIANTS="populate:-DQL_MODE=2 -DQL_LAZY_ARENA=0"
STANDALONE="final:--mode 2"
REFS="403499"
THP_MODES="madvise always"
REPS=7
# Official job: OFFICIAL=1 runs run_official_all.sh on OFFICIAL_ARGS (make_submission.py arguments).
OFFICIAL=1
OFFICIAL_ARGS="--mode 2"
