# Per-round CI plan for .github/workflows/ntt-conv-large.yml (sourced by every job).
KERNEL=0
PASSES="check time"
CHECK_LG=23
ONLY="final,b0zs"
# I/O job (exploration 011): work/ntt/io_large/run_io.sh (unit tests over all values < 1e9, timing).
IO=1
# End-to-end: "@io ARGS" builds with work/ntt/io_large/make_submission.py (io_main.cpp).
# Round 2: formatter ILP variants (QI_FMT 2: a from x; 3: two blocks interleaved), 8-token parser.
E2E=1
VARIANTS=""
STANDALONE="final:;fmt1:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=1;fmt2:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=2;fmt3:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=3;t8f3:@io --define QI_INPUT=1 --define QI_PARSE=2 --define QI_FMT=3;fmt3_probe:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=3 --probe"
REFS="403499"
THP_MODES="madvise"
REPS=7
# Official: first build must be byte-exact (its outputs verify later builds via the checker).
OFFICIAL=1
OFFICIAL_BUILDS="final:;fmt3:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=3"
