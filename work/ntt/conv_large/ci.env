# Per-round CI plan for .github/workflows/ntt-conv-large.yml (sourced by every job).
# Kernel job: KERNEL=1 runs run.sh with PASSES/ONLY/REPS/CHECK_LG.
KERNEL=0
PASSES="check time"
CHECK_LG=23
ONLY="final,b0zs,c_f265i71b23id2,c_f11i282b23id2,c_f11i71b67id2,c_f11i71b23id4"
# End-to-end job: E2E=1 runs run_e2e.sh with VARIANTS/STANDALONE/REFS/CASES_LIST/THP_MODES/REPS.
E2E=0
VARIANTS=""
STANDALONE="final:"
REFS="403499"
THP_MODES="madvise"
REPS=7
# Official job: OFFICIAL=1 builds each "name:make_submission args" and runs run_official_all.sh.
OFFICIAL=0
OFFICIAL_BUILDS="final:"
