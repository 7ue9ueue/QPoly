# Per-round CI plan for .github/workflows/ntt-conv-large.yml (sourced by every job).
KERNEL=0
PASSES="check time"
CHECK_LG=23
ONLY="final,b0zs"
# I/O job (exploration 011): work/ntt/io_large/run_io.sh (unit tests over all values < 1e9, timing).
IO=1
# End-to-end: "@io ARGS" builds with work/ntt/io_large/make_submission.py (io_main.cpp).
# Round 8: deliverable (io_large/final_io_main.cpp = ms2 128 KiB + blocks3<4> + 160 KiB) and its probe; official cases.
E2E=1
VARIANTS=""
STANDALONE="final:;io:@io --source final_io_main.cpp;io_probe:@io --source final_io_main.cpp --probe;m2X3:@io --define QI_INPUT=0 --define QI_OBUF=163840 --define QI_CHUNK=131072 --define QI_PARSE=5 --define QI_FMT=5"
REFS="403499"
THP_MODES="madvise"
REPS=7
OFFICIAL=1
OFFICIAL_BUILDS="final:;io:@io --source final_io_main.cpp;io_probe:@io --source final_io_main.cpp --probe"
