E2E=1
VARIANTS=""
STANDALONE="final:;fmt3:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=3;fmt3b:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=3 --define QI_OBUF=163840;fmt4:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=4;fmt4b:@io --define QI_INPUT=0 --define QI_PARSE=0 --define QI_FMT=4 --define QI_OBUF=163840"
REFS="403499"
